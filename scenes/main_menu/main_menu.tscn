[connection signal="pressed" from="Margin/Column/Tiles/ShakeBoxesTile" to="." method="_on_shake_boxes_tile_pressed"]
[connection signal="pressed" from="RangeOverlay/Center/Panel/Column/CancelButton" to="." method="_on_cancel_button_pressed"]
