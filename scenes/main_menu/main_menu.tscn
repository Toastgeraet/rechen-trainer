[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/main_menu/main_menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://assets/tile_shake_boxes.svg" id="2_tile"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.94, 0.9, 0.83, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 80
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 48

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 64

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 72
text = "APP_TITLE"
horizontal_alignment = 1

[node name="Tiles" type="GridContainer" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 32
theme_override_constants/v_separation = 32
columns = 2

[node name="ShakeBoxesTile" type="Button" parent="Margin/Column/Tiles"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 340)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Margin/Column/Tiles/ShakeBoxesTile"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 20.0
offset_right = -20.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Icon" type="TextureRect" parent="Margin/Column/Tiles/ShakeBoxesTile/Content"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
texture = ExtResource("2_tile")
expand_mode = 1
stretch_mode = 5

[node name="Subtitle" type="Label" parent="Margin/Column/Tiles/ShakeBoxesTile/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "TILE_SHAKE_BOXES"
horizontal_alignment = 1

[node name="RangeOverlay" type="Control" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="RangeOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.2, 0.22, 0.45)

[node name="Center" type="CenterContainer" parent="RangeOverlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="RangeOverlay/Center"]
custom_minimum_size = Vector2(560, 0)
layout_mode = 2

[node name="Column" type="VBoxContainer" parent="RangeOverlay/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="RangeTitle" type="Label" parent="RangeOverlay/Center/Panel/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 44
text = "RANGE_TITLE"
horizontal_alignment = 1
autowrap_mode = 3

[node name="RangeButtons" type="VBoxContainer" parent="RangeOverlay/Center/Panel/Column"]
unique_name_in_owner = true
layout_mode = 2
